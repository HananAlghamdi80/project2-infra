# Terraform files to ignore
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform/
.terraform.lock.hcl

# Sensitive files
*.secret
*.pem
*.key
*.vault
*.env

# Local environment / IDE
.vscode/
.idea/
*.iml

# Mac / Linux system files
.DS_Store
Thumbs.db

# Logs, temporary files
*.log
*.tmp
